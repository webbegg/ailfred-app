{
  "$defs": {
    "CallKind": {
      "description": "A tool call's kind: always `function`.",
      "enum": [
        "function"
      ],
      "type": "string"
    },
    "Content": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/ContentPart"
          },
          "type": "array"
        }
      ],
      "description": "A message's body: plain text, or parts (text and media) in order."
    },
    "ContentPart": {
      "description": "One part of a message's body, tagged by `type`.",
      "oneOf": [
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "source": {
              "$ref": "#/$defs/PartSource"
            },
            "type": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "source": {
              "$ref": "#/$defs/PartSource"
            },
            "type": {
              "const": "audio",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "source": {
              "$ref": "#/$defs/PartSource"
            },
            "type": {
              "const": "video",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "source": {
              "$ref": "#/$defs/PartSource"
            },
            "type": {
              "const": "document",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source"
          ],
          "type": "object"
        }
      ]
    },
    "Context": {
      "description": "A named piece of what's around the conversation, for the agent.",
      "properties": {
        "description": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "value"
      ],
      "type": "object"
    },
    "FunctionCall": {
      "properties": {
        "arguments": {
          "description": "As a JSON string.",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "type": "object"
    },
    "Interrupt": {
      "description": "Something a run needs from outside before it goes on (for Ailfred, an answer to a question).",
      "properties": {
        "expiresAt": {
          "type": "string"
        },
        "id": {
          "description": "What a [`Resume`] answers it by.",
          "type": "string"
        },
        "message": {
          "description": "The prompt, for whoever answers.",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "type": "object"
        },
        "reason": {
          "description": "Ailfred's: `input_required`.",
          "type": "string"
        },
        "responseSchema": {
          "additionalProperties": true,
          "description": "A JSON Schema of the answer it expects.",
          "type": "object"
        },
        "toolCallId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason"
      ],
      "type": "object"
    },
    "Message": {
      "description": "A message of the conversation, tagged by `role`.",
      "oneOf": [
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "role": {
              "const": "developer",
              "type": "string"
            }
          },
          "required": [
            "role",
            "id",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "role": {
              "const": "system",
              "type": "string"
            }
          },
          "required": [
            "role",
            "id",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "role": {
              "const": "assistant",
              "type": "string"
            },
            "toolCalls": {
              "items": {
                "$ref": "#/$defs/ToolCall"
              },
              "type": "array"
            }
          },
          "required": [
            "role",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "$ref": "#/$defs/Content"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "role": {
              "const": "user",
              "type": "string"
            }
          },
          "required": [
            "role",
            "id",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "$ref": "#/$defs/Content"
            },
            "error": {
              "description": "Why the tool failed, beside what it returned.",
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "role": {
              "const": "tool",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            }
          },
          "required": [
            "role",
            "id",
            "content",
            "toolCallId"
          ],
          "type": "object"
        },
        {
          "properties": {
            "activityType": {
              "type": "string"
            },
            "content": {
              "additionalProperties": true,
              "type": "object"
            },
            "id": {
              "type": "string"
            },
            "role": {
              "const": "activity",
              "type": "string"
            }
          },
          "required": [
            "role",
            "id",
            "activityType",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "role": {
              "const": "reasoning",
              "type": "string"
            }
          },
          "required": [
            "role",
            "id",
            "content"
          ],
          "type": "object"
        }
      ]
    },
    "PartSource": {
      "description": "Where a media part's bytes come from, tagged by `type`.",
      "oneOf": [
        {
          "description": "The bytes themselves, base64.",
          "properties": {
            "mimeType": {
              "type": "string"
            },
            "type": {
              "const": "data",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value",
            "mimeType"
          ],
          "type": "object"
        },
        {
          "properties": {
            "mimeType": {
              "type": "string"
            },
            "type": {
              "const": "url",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A handle a model provider issued.",
          "properties": {
            "mimeType": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "type": {
              "const": "file",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ReasoningRole": {
      "description": "A reasoning message's role: always `reasoning`.",
      "enum": [
        "reasoning"
      ],
      "type": "string"
    },
    "Resume": {
      "description": "An answer to one [`Interrupt`] (the schema's `ResumeEntry`).",
      "properties": {
        "interruptId": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "type": "object"
        },
        "payload": {
          "description": "The answer itself (Ailfred's: `{\"answer\": \"…\"}`)."
        },
        "status": {
          "$ref": "#/$defs/ResumeStatus"
        }
      },
      "required": [
        "interruptId",
        "status"
      ],
      "type": "object"
    },
    "ResumeStatus": {
      "enum": [
        "resolved",
        "cancelled"
      ],
      "type": "string"
    },
    "RunAgentInput": {
      "description": "What starts a run: the conversation, and the answers to the last run's questions.",
      "properties": {
        "context": {
          "items": {
            "$ref": "#/$defs/Context"
          },
          "type": "array"
        },
        "forwardedProps": true,
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "parentRunId": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "string"
        },
        "resume": {
          "items": {
            "$ref": "#/$defs/Resume"
          },
          "type": "array"
        },
        "runId": {
          "type": "string"
        },
        "state": true,
        "threadId": {
          "type": "string"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/Tool"
          },
          "type": "array"
        }
      },
      "required": [
        "threadId",
        "runId",
        "messages"
      ],
      "type": "object"
    },
    "RunOutcome": {
      "description": "Why a run ended, tagged by `type`. More may come in a later version.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "success",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "It waits for answers: the next run resumes it.",
          "properties": {
            "interrupts": {
              "items": {
                "$ref": "#/$defs/Interrupt"
              },
              "type": "array"
            },
            "type": {
              "const": "interrupt",
              "type": "string"
            }
          },
          "required": [
            "type",
            "interrupts"
          ],
          "type": "object"
        },
        {
          "description": "Whoever ran it stopped it.",
          "properties": {
            "type": {
              "const": "cancelled",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "TextRole": {
      "description": "Who a streamed text message is from.",
      "enum": [
        "developer",
        "system",
        "assistant",
        "user"
      ],
      "type": "string"
    },
    "Tool": {
      "description": "A tool the client offers the agent.",
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parameters": {
          "description": "A JSON Schema of its arguments."
        }
      },
      "required": [
        "name",
        "description"
      ],
      "type": "object"
    },
    "ToolCall": {
      "description": "A call an assistant message made.",
      "properties": {
        "function": {
          "$ref": "#/$defs/FunctionCall"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/CallKind"
        }
      },
      "required": [
        "id",
        "type",
        "function"
      ],
      "type": "object"
    },
    "ToolRole": {
      "description": "A tool result's role: always `tool`.",
      "enum": [
        "tool"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One event of a run, tagged by `type`. More may come in a later version.",
  "oneOf": [
    {
      "description": "A run starts.",
      "properties": {
        "input": {
          "allOf": [
            {
              "$ref": "#/$defs/RunAgentInput"
            }
          ],
          "description": "What the run was asked: the server sends the user message a run answers here, so a\nclient that didn't send it sees it too."
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "parentRunId": {
          "description": "The run that started this one as a run of its own (Ailfred's runs have none).",
          "type": "string"
        },
        "protocolVersion": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "RUN_STARTED",
          "type": "string"
        }
      },
      "required": [
        "type",
        "threadId",
        "runId"
      ],
      "type": "object"
    },
    {
      "description": "A run ends without failing: done, waiting for answers, or stopped.",
      "properties": {
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "outcome": {
          "allOf": [
            {
              "$ref": "#/$defs/RunOutcome"
            }
          ],
          "description": "Absent means success."
        },
        "result": true,
        "runId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "RUN_FINISHED",
          "type": "string"
        }
      },
      "required": [
        "type",
        "threadId",
        "runId"
      ],
      "type": "object"
    },
    {
      "description": "A run ends failed.",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "RUN_ERROR",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "type": "object"
    },
    {
      "description": "A text message opens.",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "role": {
          "allOf": [
            {
              "$ref": "#/$defs/TextRole"
            }
          ],
          "description": "Absent means assistant."
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "TEXT_MESSAGE_START",
          "type": "string"
        }
      },
      "required": [
        "type",
        "messageId"
      ],
      "type": "object"
    },
    {
      "description": "More of a text message.",
      "properties": {
        "delta": {
          "type": "string"
        },
        "messageId": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "TEXT_MESSAGE_CONTENT",
          "type": "string"
        }
      },
      "required": [
        "type",
        "messageId",
        "delta"
      ],
      "type": "object"
    },
    {
      "description": "A text message closes.",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "TEXT_MESSAGE_END",
          "type": "string"
        }
      },
      "required": [
        "type",
        "messageId"
      ],
      "type": "object"
    },
    {
      "description": "A span of reasoning opens.",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "REASONING_START",
          "type": "string"
        }
      },
      "required": [
        "type",
        "messageId"
      ],
      "type": "object"
    },
    {
      "description": "A reasoning message opens within the span.",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "role": {
          "$ref": "#/$defs/ReasoningRole"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "REASONING_MESSAGE_START",
          "type": "string"
        }
      },
      "required": [
        "type",
        "messageId",
        "role"
      ],
      "type": "object"
    },
    {
      "description": "More of a reasoning message.",
      "properties": {
        "delta": {
          "type": "string"
        },
        "messageId": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "REASONING_MESSAGE_CONTENT",
          "type": "string"
        }
      },
      "required": [
        "type",
        "messageId",
        "delta"
      ],
      "type": "object"
    },
    {
      "description": "A reasoning message closes.",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "REASONING_MESSAGE_END",
          "type": "string"
        }
      },
      "required": [
        "type",
        "messageId"
      ],
      "type": "object"
    },
    {
      "description": "A span of reasoning closes.",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "REASONING_END",
          "type": "string"
        }
      },
      "required": [
        "type",
        "messageId"
      ],
      "type": "object"
    },
    {
      "description": "A tool call opens.",
      "properties": {
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "parentMessageId": {
          "type": "string"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "toolCallId": {
          "type": "string"
        },
        "toolCallName": {
          "type": "string"
        },
        "type": {
          "const": "TOOL_CALL_START",
          "type": "string"
        }
      },
      "required": [
        "type",
        "toolCallId",
        "toolCallName"
      ],
      "type": "object"
    },
    {
      "description": "More of a tool call's arguments (their pieces make a JSON document).",
      "properties": {
        "delta": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "toolCallId": {
          "type": "string"
        },
        "type": {
          "const": "TOOL_CALL_ARGS",
          "type": "string"
        }
      },
      "required": [
        "type",
        "toolCallId",
        "delta"
      ],
      "type": "object"
    },
    {
      "description": "A tool call's arguments are complete.",
      "properties": {
        "metadata": {
          "additionalProperties": true,
          "description": "Extra information; Ailfred's own sits under the key `ailfred`.",
          "type": "object"
        },
        "timestamp": {
          "description": "When it happened, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "toolCallId": {
          "type": "string"
        },
        "type": {
          "const": "TOOL_CALL_END",
          "type": "string"
        }
      },
      "required": [
        "type",
        "toolCallId"
      ],
      "type": "object"
    },
    {
      "description": "What a tool returned, as a new tool message.",
      "properties": {
        "content": {
          "allOf": [
            {
              "$ref": "#/$defs/Content"
            }
          ],
