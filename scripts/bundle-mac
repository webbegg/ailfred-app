#!/usr/bin/env bash
# Builds Ailfred in release mode, assembles and signs Ailfred.app in the target folder
# (`target/bundle/Ailfred.app`), and prints its path: the one line on stdout. Used by
# scripts/install-mac and scripts/make-dmg.
#
# Signing: a stable identity keeps the Screen Recording grant across reinstalls (macOS ties it
# to the bundle id and certificate; ad hoc ties it to each build's hash). A local self-signed
# "Ailfred Local Signing" certificate (scripts/make-signing-identity) is used when present, else
# the one made before the rename, "Capibarapp Local Signing"; MAC_APP_SIGN=<identity> overrides;
# MAC_APP_SIGN=- signs ad hoc on purpose.
set -euo pipefail
cd "$(dirname "$0")/.."

NAME=Ailfred
ID=com.ailfred
EXE=ailfred
# The app's package (the workspace also holds crates/ailfred-core).
VERSION=$(cargo metadata --format-version 1 --no-deps | python3 -c 'import json,sys; print(next(p["version"] for p in json.load(sys.stdin)["packages"] if p["name"] == "ailfred"))')
TARGET=$(cargo metadata --format-version 1 --no-deps | python3 -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])')
BUILD=$(git rev-list --count HEAD 2>/dev/null || echo 1)

for cert in "Ailfred Local Signing" "Capibarapp Local Signing"; do
  if [ -z "${MAC_APP_SIGN:-}" ] && security find-certificate -c "$cert" >/dev/null 2>&1; then
    MAC_APP_SIGN="$cert"
  fi
done
IDENTITY=${MAC_APP_SIGN:--}
[ "$IDENTITY" = "-" ] && echo "bundle-mac: signing ad hoc; Screen Recording will be asked again after each reinstall" >&2

# AILFRED_BUILD: Settings shows it (src/settings_ui.rs). AILFRED_CHANNEL=stable: the installed
# app's identity and folders (`com.ailfred`); a build without it is a dev build (src/settings.rs,
# `product`). Cargo rebuilds when either changes.
AILFRED_CHANNEL=stable AILFRED_BUILD="$BUILD" cargo build --release --locked -p ailfred >&2
# The web view's page: one self-contained web/dist/index.html (docs/web-view.md), always from a
# clean install of the lockfile (never a stale or changed web/node_modules), no install scripts.
npm --prefix web ci --ignore-scripts >&2
npm --prefix web run build >&2

APP="$TARGET/bundle/$NAME.app"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$TARGET/release/$EXE" "$APP/Contents/MacOS/$EXE"
mkdir -p "$APP/Contents/Resources/web"
cp web/dist/index.html "$APP/Contents/Resources/web/index.html"
# The app's icon (Finder, Launchpad), drawn by the app itself at 1024 px, then scaled into an
# iconset.
ICONSET=$(mktemp -d)/AppIcon.iconset
mkdir -p "$ICONSET"
"$APP/Contents/MacOS/$EXE" --app-icon "$ICONSET/icon_512x512@2x.png" >&2
for size in 16 32 128 256 512; do
  sips -z $size $size "$ICONSET/icon_512x512@2x.png" --out "$ICONSET/icon_${size}x${size}.png" >/dev/null
  double=$((size * 2))
  if [ $double -lt 1024 ]; then
    sips -z $double $double "$ICONSET/icon_512x512@2x.png" --out "$ICONSET/icon_${size}x${size}@2x.png" >/dev/null
  fi
done
iconutil -c icns "$ICONSET" -o "$APP/Contents/Resources/AppIcon.icns"
rm -rf "$(dirname "$ICONSET")"
PLIST="$APP/Contents/Info.plist"
plutil -create xml1 "$PLIST"
plutil -insert CFBundleName -string "$NAME" "$PLIST"
plutil -insert CFBundleDisplayName -string "$NAME" "$PLIST"
plutil -insert CFBundleIdentifier -string "$ID" "$PLIST"
plutil -insert CFBundleExecutable -string "$EXE" "$PLIST"
plutil -insert CFBundlePackageType -string APPL "$PLIST"
plutil -insert CFBundleShortVersionString -string "$VERSION" "$PLIST"
plutil -insert CFBundleVersion -string "$BUILD" "$PLIST"
plutil -insert CFBundleIconFile -string AppIcon "$PLIST"
# SCScreenshotManager needs macOS 14.
plutil -insert LSMinimumSystemVersion -string 14.0 "$PLIST"
# Menu-bar-less accessory from the first instant: no Dock icon flash before Rune sets the policy.
plutil -insert LSUIElement -bool true "$PLIST"
plutil -insert NSHighResolutionCapable -bool true "$PLIST"
# Links: `open ailfred://toggle` shows or hides the quick input (src/link.rs).
plutil -insert CFBundleURLTypes -json '[{"CFBundleURLName":"com.ailfred","CFBundleURLSchemes":["ailfred"]}]' "$PLIST"

codesign --force --sign "$IDENTITY" "$APP" >&2
if [ "$IDENTITY" != "-" ] && ! codesign -d -r- "$APP" 2>&1 | grep -q "certificate leaf"; then
  echo "bundle-mac: $APP isn't signed with '$IDENTITY'" >&2
  exit 1
fi

echo "$APP"
