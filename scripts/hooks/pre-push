#!/bin/bash
# Runs scripts/check before a push, as there is no CI. On once per clone:
#   git config core.hooksPath scripts/hooks
# It checks the working tree of the worktree you push from, so commit first. A push that only
# deletes branches or tags is let through unchecked. `git push --no-verify` skips it.
set -euo pipefail

zero=0000000000000000000000000000000000000000
updates=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ "$local_sha" = "$zero" ] || updates=$((updates + 1))
done
if [ "$updates" -eq 0 ]; then
    exit 0
fi

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "pre-push: uncommitted changes; scripts/check would check them, not what you push." >&2
    echo "pre-push: commit or stash them first (or push with --no-verify)." >&2
    exit 1
fi

echo "pre-push: scripts/check (git push --no-verify skips it)" >&2
exec "$(git rev-parse --show-toplevel)/scripts/check"
