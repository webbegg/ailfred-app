#!/usr/bin/env bash
# Makes the self-signed code-signing identity "Ailfred Local Signing" that scripts/bundle-mac
# signs with: a stable identity keeps the Screen Recording grant across reinstalls (ad hoc
# signing ties it to each build). Once per Mac; does nothing when the identity is there.
#
# The certificate isn't trusted by the system (`security find-identity` says
# CSSMERR_TP_NOT_TRUSTED): codesign signs with it all the same, and changing trust would need an
# administrator. It is for this Mac only: other Macs see an unidentified developer.
#
# KEYCHAIN=<path> puts it in another keychain (default: the login keychain);
# SIGNING_NAME=<name> names it differently.
set -euo pipefail

NAME=${SIGNING_NAME:-Ailfred Local Signing}
KEYCHAIN=${KEYCHAIN:-$HOME/Library/Keychains/login.keychain-db}

if security find-certificate -c "$NAME" "$KEYCHAIN" >/dev/null 2>&1; then
  echo "make-signing-identity: \"$NAME\" is already in $KEYCHAIN"
  exit 0
fi

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
cat >"$WORK/cert.cnf" <<EOF
[req]
distinguished_name = dn
x509_extensions = ext
prompt = no
[dn]
CN = $NAME
[ext]
basicConstraints = critical,CA:false
keyUsage = critical,digitalSignature
extendedKeyUsage = critical,codeSigning
EOF
# The system's LibreSSL: its PKCS#12 is one `security import` reads (OpenSSL 3's default isn't).
/usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -config "$WORK/cert.cnf" \
  -keyout "$WORK/key.pem" -out "$WORK/cert.pem" 2>/dev/null
PASS=$(/usr/bin/openssl rand -hex 16)
/usr/bin/openssl pkcs12 -export -inkey "$WORK/key.pem" -in "$WORK/cert.pem" -name "$NAME" \
  -passout "pass:$PASS" -out "$WORK/identity.p12"
# -T: codesign may use the key without asking each time.
security import "$WORK/identity.p12" -k "$KEYCHAIN" -P "$PASS" -T /usr/bin/codesign >/dev/null
echo "make-signing-identity: made \"$NAME\" in $KEYCHAIN"
