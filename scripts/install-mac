#!/usr/bin/env bash
# Builds and signs Ailfred.app (scripts/bundle-mac) and installs it as ~/Applications/Ailfred.app
# with Rune's installer (atomic swap, launch, rollback). Extra arguments go to the installer.
#
# --no-rune-ready: Rune writes its ready receipt from a window's on_ready, and Ailfred has no
# window (only an overlay), so the installer checks that macOS reports the app as launched.
set -euo pipefail
cd "$(dirname "$0")/.."

APP=$(scripts/bundle-mac)
PLIST="$APP/Contents/Info.plist"
NAME=$(plutil -extract CFBundleName raw "$PLIST")
ID=$(plutil -extract CFBundleIdentifier raw "$PLIST")
EXE=$(plutil -extract CFBundleExecutable raw "$PLIST")

exec ../_references/rune/scripts/mac-app \
  --name "$NAME" --id "$ID" --exe "$EXE" --bundle "$APP" --no-rune-ready "$@"
